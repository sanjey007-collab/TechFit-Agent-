# ===================================================================
# TechFit Agent — AI-Powered RAM & Charger Compatibility Checker
# Environment Configuration Template
# DO NOT PUT REAL SECRETS IN THIS FILE (.env.example)
# Copy this file to .env and fill in real values.
# ===================================================================

# -------------------------------------------------------------------
# Core Server & Database Configuration
# -------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL Database URL
# Local fallback: sqlite+aiosqlite:///./techfit.db or postgresql+asyncpg://postgres:postgres@localhost:5432/techfit
# Render production: postgresql+asyncpg://user:pass@host/dbname
DATABASE_URL=sqlite+aiosqlite:///./techfit.db

# -------------------------------------------------------------------
# Mock Shopping Store
# -------------------------------------------------------------------
MOCK_STORE_URL=http://localhost:8001
# Shared bearer token for API backend to authenticate with the mock store
MOCK_STORE_SERVICE_TOKEN=techfit-mock-store-service-token-dev-secret

# -------------------------------------------------------------------
# Admin & Security
# -------------------------------------------------------------------
# Token used to access /api/admin/config-status
ADMIN_API_KEY=admin-dev-key-change-in-production

# -------------------------------------------------------------------
# Required Onboarding Key #1: Search Provider (Manufacturer Specs)
# -------------------------------------------------------------------
# Provider options: 'google_custom_search', 'serper', 'serpapi', 'brave'
SEARCH_PROVIDER=serper
SEARCH_API_KEY=your_search_api_key_here

# If using Google Custom Search / Programmable Search:
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_cx_id_here

# -------------------------------------------------------------------
# Required Onboarding Key #2: Gemini API Key (LLM Planning & Extraction)
# -------------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# -------------------------------------------------------------------
# Required Onboarding Key #3: Product Details Provider (Catalog Enrichment)
# -------------------------------------------------------------------
# Provider options: 'upcitemdb', 'trustedparts', 'rapidapi', 'mock_store_only'
PRODUCT_DETAILS_PROVIDER=upcitemdb
PRODUCT_DETAILS_API_KEY=your_product_details_api_key_here
PRODUCT_DETAILS_BASE_URL=https://api.upcitemdb.com/prod/trial/lookup
